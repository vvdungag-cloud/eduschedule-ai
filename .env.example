# Cấu hình biến môi trường EduSchedule AI
# TẤT CẢ CÁC BIẾN MÔI TRƯỜNG LÀ TÙY CHỌN (OPTIONAL)
# Mặc định để trống "" - Hệ thống hoạt động bình thường, cho phép Share và Publish không cần nhập secrets.

# Gemini API Key (Tùy chọn - nếu để trống hệ thống dùng thuật toán lập lịch tích hợp sẵn)
GEMINI_API_KEY=

# Cấu hình gửi Email SMTP / Gmail (Tùy chọn - mặc định để trống "")
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cấu hình gửi Zalo Webhook / OA (Tùy chọn - mặc định để trống "")
ZALO_WEBHOOK_URL=
ZALO_OA_ACCESS_TOKEN=
