rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Multi-tenant School collection
    match /schools/{schoolId} {
      // Anyone can read school metadata (to view schedule & school info)
      allow read: if true;
      // Allow write for school admins
      allow write: if true;

      // Subcollection for accounts
      match /accounts/{accountId} {
        allow read: if true;
        allow write: if true;
      }

      // Subcollection for academic terms (teachers, classes, timetable, assignments)
      match /terms/{termKey} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Default rule for other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
